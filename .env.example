# Public Supabase project settings; the publishable key is safe to expose client-side.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Optional compatibility with Supabase projects that still expose the legacy anon key.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Server-only secret used by authenticated photo API routes. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Optional server-only FastAPI pose-preparation service. Never expose this URL/key with NEXT_PUBLIC_.
TRYVORA_POSE_SERVICE_URL=http://127.0.0.1:8001
TRYVORA_POSE_SERVICE_KEY=

# Server-only FASHN API integration; generation is disabled unless explicitly enabled.
FASHN_API_KEY=
TRYVORA_AI_TRYON_ENABLED=false

# Optional contact recipient. Leave blank to keep contact delivery disabled.
NEXT_PUBLIC_CONTACT_EMAIL=
